# Local development defaults are used when these are omitted.
# Generate a unique, private value before running in production.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for local SQLite. Use a persistent database in production.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Defaults to the inverse of DEBUG.
# SECURE_SSL_REDIRECT=False

# Enable only after confirming the production site is fully HTTPS.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
